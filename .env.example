HOST=127.0.0.1
PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=sqlite+aiosqlite:///./data/db.sqlite
UPLOAD_DIR=./data/uploads
VECTORSTORE_DIR=./data/vectorstore
MODELS_DIR=./models

# Options: mlx-community/Qwen2.5-1.5B-Instruct-4bit (fast), gpt-3.5-turbo (better), gpt-4 (best)
# recommended for RAG by grok: microsoft/Phi-4-mini-instruct
LLM_MODEL=microsoft/Phi-4-mini-instruct-8bit
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.1
LLM_REPETITION_PENALTY=1.15

# Cross-encoder re-ranker for improved retrieval relevance scoring
RERANKER_MODEL=Alibaba-NLP/gte-reranker-modernbert-base
RERANKER_ENABLED=True

# Response verification: checks each sentence against source chunks
VERIFICATION_ENABLED=True
VERIFICATION_SIMILARITY_THRESHOLD=0.65
VERIFICATION_REMOVE_UNSUPPORTED=True

# Minimum relevance score for chunk retrieval
MIN_RELEVANCE_SCORE=0.15

# Options: all-MiniLM-L6-v2 (fast), all-mpnet-base-v2 (better), bge-small-en-v1.5 (balanced)
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_BATCH_SIZE=32

# Hugging Face token for private models and datasets. Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=settings-hf_token-placeholder
HF_HUB_OFFLINE=1

DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

# Set to 0 to disable caching entirely. Any positive value = number of days cache entries live.
CACHE_EXPIRY_DAYS=3

# uv always uses `.venv` by default; set explicitly as a fallback
UV_PROJECT_ENVIRONMENT=.venv

STREAMLIT_SERVER_PORT=8501
API_BASE_URL=http://localhost:8000

API_DOCS_DSPY_ENABLED=true
