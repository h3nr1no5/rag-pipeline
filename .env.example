HOST=127.0.0.1
PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=sqlite+aiosqlite:///./data/db.sqlite
UPLOAD_DIR=./data/uploads
VECTORSTORE_DIR=./data/vectorstore
MODELS_DIR=./models

LLM_MODEL=mlx-community/Qwen2.5-1.5B-Instruct-4bit
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.5
LLM_REPETITION_PENALTY=1.15

# Options: all-MiniLM-L6-v2 (fast), all-mpnet-base-v2 (better), bge-small-en-v1.5 (balanced)
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_BATCH_SIZE=32

# Hugging Face token for private models and datasets. Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=settings-hf_token-placeholder
HF_HUB_OFFLINE=1

DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50

CACHE_EXPIRY_DAYS=3

STREAMLIT_SERVER_PORT=8501
API_BASE_URL=http://localhost:8000
